.{
    .name = .fluxion_script,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0xda72f72e2a83ddae,
    // The commits fluxion-reflect and fluxion-engine pin, so a game gets one
    // copy of each.
    .dependencies = .{
        .fluxion_text = .{
            .url = "git+https://github.com/kisstp2006/fluxion-text#41010ffb170fb13a72cc1751ee6031f8d1eebb6f",
            .hash = "fluxion_text-0.1.0-cIhfioG2AgAJJ9hB0dOMWhHvk6ConZmD0OTreG41NoLX",
        },
        .fluxion_hash = .{
            .url = "git+https://github.com/kisstp2006/fluxion-hash#d7211dc2a0e961a67ffb070f45e6089b8125069c",
            .hash = "fluxion_hash-0.1.0-Zu520_IkAQCn0T4xz2CCSD724jkXcbzZBb_dFirBrjS2",
        },
        .fluxion_json = .{
            .url = "git+https://github.com/kisstp2006/fluxion-json#5b156eea39ad6f1ad1642c971008a0bbbbd21c0f",
            .hash = "fluxion_json-0.1.0-sFlLPa1yBQCYVZD-64nMnRtnhjH6P3xbnq1ftDyIs1DB",
        },
        .fluxion_reflect = .{
            .url = "git+https://github.com/kisstp2006/fluxion-reflect#2f48e6ef8e44a55039cdbd8cbbd3521f344cb8f8",
            .hash = "fluxion_reflect-0.1.0-Aw2l_2DGBQAt1GqJ0oVM7f-9xEwagzceO1A2F4mfDKVI",
        },

        // Flux in its code editor, `fluxion_script_code`. Lazy, and asked for
        // only when this is the package being built or a dependant asks
        // for `.code = true`.
        .fluxion_code = .{
            .url = "git+https://github.com/kisstp2006/fluxion-code#6e3db8d240062d73c186ba58978b568b450a9049",
            .hash = "fluxion_code-0.1.0-hzHnKLQdAwD0C8e11_tEhfgKoh9kZdqjVwVpWDkSW7Oo",
            .lazy = true,
        },

        // What the mini IDE in `examples/ide` draws with: a window, a GPU, a
        // font and fluxion-ui. Lazy, and asked for only when this is the
        // package being built, so a game using the language never fetches
        // them. The commits fluxion-ui pins, so each is one package.
        .fluxion_ui = .{
            .url = "git+https://github.com/kisstp2006/fluxion-ui#2bebec3bf5fe0c69d8e362fcfa1fcccc9b1811fc",
            .hash = "fluxion_ui-0.1.0-lw4Ws3b6DwBUgd35Zdo5IqecZYB2HsHDNpsGcKFhl-h6",
            .lazy = true,
        },
        .fluxion_platform = .{
            .url = "git+https://github.com/kisstp2006/fluxion-platform#70464d7f4f07486bbdeecadb5b5af2d786416b14",
            .hash = "fluxion_platform-0.1.0-WsOjUQpvFwAaRZAJe78KHp5AjgI4_aUARNR5KDkk-VmU",
            .lazy = true,
        },
        .fluxion_rhi = .{
            .url = "git+https://github.com/kisstp2006/fluxion-rhi#6db82f30ecf9fa03d8b41c910eebf1866669b021",
            .hash = "fluxion_rhi-0.1.0--pvwD6yTDwDrhqQcFJicuttLlnSLQ5B1S_vCiHGiWicc",
            .lazy = true,
        },
        .fluxion_font = .{
            .url = "git+https://github.com/kisstp2006/fluxion-font#f666e62f498e5bfe04361c7f1bf6531334a51dbf",
            .hash = "fluxion_font-0.1.0-f3pT4rn1AwBbbEom4emICxRn1vGPQvsRhUc0_lCawLB8",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "examples",
        "tests",
        "README.md",
        "LICENSE",
    },
}
